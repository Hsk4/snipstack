+"use client";
+
+import Link from "next/link";
+import { UserButton } from "@clerk/nextjs";
+import { BookOpen, Folder, Layers, Sparkles, SquareTerminal, Star } from "lucide-react";
+
+import { buttonVariants } from "@/components/ui/button";
+
+export type Collection = { name: string; count: number };
+
+interface DashboardSidebarProps {
+  workspaceName: string;
+  collections: Collection[];
+  activeCollection: string | null;
+  onSelectCollection: (name: string | null) => void;
+  /** True when no collection is selected, i.e. "All snippets" is the active view. */
+  allActive: boolean;
+}
+
+const itemBase =
+  "flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-[13px] transition-colors";
+
+function SectionLabel({ children }: { children: React.ReactNode }) {
+  return (
+    <p className="px-1 text-[10px] font-medium uppercase tracking-[0.14em] text-muted-foreground/70">
+      {children}
+    </p>
+  );
+}
+
+export function DashboardSidebar({
+  workspaceName,
+  collections,
+  activeCollection,
+  onSelectCollection,
+  allActive,
+}: DashboardSidebarProps) {
+  return (
+    <aside className="hidden w-64 shrink-0 flex-col gap-5 overflow-y-auto border-r border-sidebar-border bg-sidebar p-4 md:flex">
+      <Link
+        href="/"
+        className="flex items-center gap-2 px-1 text-lg font-bold tracking-tight"
+      >
+        <Layers className="size-5 text-primary" />
+        snipstack
+      </Link>
+
+      <div className="rounded-lg border border-border bg-card px-3 py-2 text-[13px] text-foreground/90">
+        {workspaceName}
+      </div>
+
+      <nav className="space-y-1.5" aria-label="Workspace">
+        <SectionLabel>Workspace</SectionLabel>
+        <button
+          type="button"
+          onClick={() => onSelectCollection(null)}
+          aria-current={allActive ? "page" : undefined}
+          className={`${itemBase} ${
+            allActive
+              ? "bg-secondary font-medium text-foreground"
+              : "text-muted-foreground hover:bg-secondary/60 hover:text-foreground"
+          }`}
+        >
+          <Layers className="size-4" />
+          All snippets
+        </button>
+        <Link
+          href="/playground"
+          className={`${itemBase} text-muted-foreground hover:bg-secondary/60 hover:text-foreground`}
+        >
+          <SquareTerminal className="size-4" />
+          Playground
+        </Link>
+        {/* Favorites / recents need data the snippets table doesn't track yet. */}
+        <button
+          type="button"
+          disabled
+          title="Coming soon"
+          className={`${itemBase} cursor-not-allowed text-muted-foreground/50`}
+        >
+          <Star className="size-4" />
+          Favorites
+        </button>
+        <button
+          type="button"
+          disabled
+          title="Coming soon"
+          className={`${itemBase} cursor-not-allowed text-muted-foreground/50`}
+        >
+          <BookOpen className="size-4" />
+          Recently opened
+        </button>
+      </nav>
+
+      <div className="space-y-1.5">
+        <SectionLabel>Collections</SectionLabel>
+        {collections.length === 0 ? (
+          <p className="px-3 py-2 text-xs text-muted-foreground">
+            Tag your snippets to group them into collections.
+          </p>
+        ) : (
+          collections.map((collection) => {
+            const active = activeCollection === collection.name;
+            return (
+              <button
+                key={collection.name}
+                type="button"
+                onClick={() => onSelectCollection(active ? null : collection.name)}
+                aria-pressed={active}
+                className={`${itemBase} justify-between ${
+                  active
+                    ? "bg-secondary text-foreground"
+                    : "text-muted-foreground hover:bg-secondary/60 hover:text-foreground"
+                }`}
+              >
+                <span className="flex min-w-0 items-center gap-2.5">
+                  <Folder className="size-4 shrink-0" />
+                  <span className="truncate">{collection.name}</span>
+                </span>
+                <span className="text-xs tabular-nums">
+                  {String(collection.count).padStart(2, "0")}
+                </span>
+              </button>
+            );
+          })
+        )}
+      </div>
+
+      <div className="mt-auto space-y-3">
+        <div className="rounded-xl border border-border bg-card p-4">
+          <Sparkles className="mb-2 size-4 text-primary" />
+          <p className="text-[13px] font-semibold">Small snippets. Big ideas.</p>
+          <p className="mt-1 text-xs leading-relaxed text-muted-foreground">
+            Your next good idea starts with a little practice.
+          </p>
+          <Link
+            href="/playground"
+            className={`${buttonVariants({ size: "lg" })} mt-3 w-full`}
+          >
+            Open playground
+          </Link>
+        </div>
+
+        <div className="flex items-center px-1">
+          <UserButton
+            showName
+            appearance={{
+              elements: {
+                userButtonOuterIdentifier: "text-foreground text-[13px]",
+              },
+            }}
+          />
+        </div>
+      </div>
+    </aside>
+  );
+}
diff --git a/components/dashboard/SnippetTile.tsx b/components/dashboard/SnippetTile.tsx
new file mode 100644
index 0000000..11aac59
--- /dev/null
+++ b/components/dashboard/SnippetTile.tsx
@@ -0,0 +1,83 @@
+"use client";
+
+import { useState } from "react";
+import { Check, Copy, Trash2 } from "lucide-react";
+
+import { deleteSnippet } from "@/app/actions/snippet";
+import { CodePreview } from "@/components/dashboard/CodePreview";
+import { languageLabel, type SnippetView } from "@/components/dashboard/types";
+
+export function SnippetTile({ snippet }: { snippet: SnippetView }) {
+  const [copied, setCopied] = useState(false);
+  const [deleting, setDeleting] = useState(false);
+
+  async function handleCopy() {
+    try {
+      await navigator.clipboard.writeText(snippet.code);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 1800);
+    } catch (error: unknown) {
+      console.error("Failed to copy snippet:", error);
+    }
+  }
+
+  async function handleDelete() {
+    if (!confirm(`Delete "${snippet.title}"? This can't be undone.`)) return;
+    setDeleting(true);
+    const result = await deleteSnippet(snippet.id);
+    if (!result.success) setDeleting(false);
+  }
+
+  return (
+    <article
+      className={`group flex flex-col gap-3 rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary/30 ${
+        deleting ? "pointer-events-none opacity-50" : ""
+      }`}
+    >
+      <header className="flex items-start justify-between gap-3">
+        <h3 className="truncate text-sm font-semibold text-foreground">
+          {snippet.title}
+        </h3>
+        <span className="shrink-0 text-xs font-medium text-primary">
+          {languageLabel(snippet.language)}
+        </span>
+      </header>
+
+      <p className="line-clamp-1 min-h-4 text-xs text-muted-foreground">
+        {snippet.description}
+      </p>
+
+      <div className="relative">
+        <CodePreview code={snippet.code} language={snippet.language} />
+        <div className="absolute right-2 top-2 flex gap-1 opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100">
+          <button
+            type="button"
+            onClick={handleCopy}
+            aria-label={copied ? "Copied" : "Copy snippet"}
+            className="grid size-7 place-items-center rounded-md border border-border bg-secondary text-secondary-foreground hover:bg-accent"
+          >
+            {copied ? (
+              <Check className="size-3.5 text-primary" />
+            ) : (
+              <Copy className="size-3.5" />
+            )}
+          </button>
+          <button
+            type="button"
+            onClick={handleDelete}
+            aria-label="Delete snippet"
+            className="grid size-7 place-items-center rounded-md border border-border bg-secondary text-secondary-foreground hover:bg-accent hover:text-destructive"
+          >
+            <Trash2 className="size-3.5" />
+          </button>
+        </div>
+      </div>
+
+      <footer className="flex items-center gap-1.5 text-[11px] text-muted-foreground">
+        <span>Updated {snippet.updatedLabel}</span>
+        <span aria-hidden>·</span>
+        <span>{snippet.isPublic ? "Public" : "Personal"}</span>
+      </footer>
+    </article>
+  );
+}
diff --git a/components/dashboard/types.ts b/components/dashboard/types.ts
new file mode 100644
index 0000000..287baba
--- /dev/null
+++ b/components/dashboard/types.ts
@@ -0,0 +1,26 @@
+import type { Snippet } from "@/app/types";
+
+/** Serializable snippet shape handed from the server page to the client dashboard. */
+export type SnippetView = Omit<Snippet, "createdAt" | "updatedAt"> & {
+  /** ISO timestamp, used for sorting. */
+  updatedAt: string;
+  /** Pre-formatted on the server ("2 hours ago") so SSR and hydration agree. */
+  updatedLabel: string;
+};
+
+export const LANGUAGE_LABELS: Record<string, string> = {
+  typescript: "TypeScript",
+  javascript: "JavaScript",
+  python: "Python",
+  go: "Go",
+  rust: "Rust",
+  html: "HTML",
+  css: "CSS",
+  json: "JSON",
+  markdown: "Markdown",
+  sql: "SQL",
+};
+
+export function languageLabel(language: string): string {
+  return LANGUAGE_LABELS[language] ?? language;
+}
